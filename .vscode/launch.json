{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SystemC-AMS",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/sc_main.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build SystemC-AMS Project",
      "symbolSearchPath": "",
      "additionalSOLibSearchPath": "",
      "sourceMap": {},
      "logging": {
        "trace": false,
        "traceResponse": false,
        "engineLogging": false
      }
    }
  ]
}
